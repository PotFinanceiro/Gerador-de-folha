# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE — VERCEL + SUPABASE + WORKER
# Programa Operação Trabalho / Rede Cidadã · By WayCode
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Configurações do Projeto no painel Supabase: Project Settings > API)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Chave secreta de serviço (usada exclusivamente no backend seguro e no worker):
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui

# ------------------------------------------------------------------------------
# 2. WORKER DE PROCESSAMENTO (Microserviço Python + LibreOffice)
# ------------------------------------------------------------------------------
# Em desenvolvimento local:
WORKER_URL=http://localhost:8000

# Em produção (URL do serviço no Cloud Run, Railway, Render ou VPS):
# WORKER_URL=https://worker-folha-sua-url.a.run.app

# Token de segurança opcional para proteger chamadas entre Vercel e o Worker:
WORKER_SECRET_TOKEN=seu-token-secreto-compartilhado

